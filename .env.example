# All optional. The site runs with none of these set.
NEXT_PUBLIC_SITE_URL=https://binbusters-emeraldcoast.com
NEXT_PUBLIC_GA_ID=                      # GA4 measurement ID, loads on Vercel production only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # Search Console meta fallback (DNS TXT preferred)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_BRAND_GBP_URL=              # Google Business Profile Maps link -> schema sameAs + hasMap
NEXT_PUBLIC_GBP_REVIEW_URL=             # "Write a review" link for /review (from the Business Profile)
NEXT_PUBLIC_BRAND_EMAIL=                # switch to jarrett@binbusters-emeraldcoast.com once Workspace is live
NEXT_PUBLIC_BOOKING_URL=                # Jobber work-request link (default is the current one)
# Lead delivery from /api/pipeline (any or none)
RESEND_API_KEY=
LEAD_EMAIL_TO=                          # comma-separated
LEAD_EMAIL_FROM=                        # e.g. "Bin Busters website <leads@binbusters-emeraldcoast.com>" once the domain is verified in Resend
PIPELINE_WEBHOOK_URL=                   # Zapier/Make/Slack/CRM webhook
